# Public-safe environment variables.
# The first two are required to run the Next.js app locally.
# The token + revalidation secret are placeholders — generate your own.

# Sanity CMS (public project id/dataset — already exposed in the live bundle)
NEXT_PUBLIC_SANITY_PROJECT_ID=n6xqwypu
NEXT_PUBLIC_SANITY_DATASET=production

# Required only for Sanity Studio / content operations. Replace with your own token.
SANITY_API_TOKEN=sk-placeholder

# Used for on-demand revalidation. Replace with your own value.
REVALIDATION_SECRET=placeholder-revalidation-secret
